{"nodes": [{"id": "docs_security_audit_2026_09_14", "label": "Full Security Audit 2026-09-14 (v2 Consolidated)", "file_type": "document", "source_file": "docs/SECURITY-AUDIT-2026-09-14.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only line-by-line re-audit: verdict \u2014 no critical/high exploitable against a correctly-configured backend, but the whole posture rests on the live DB matching the docs (real prior drift); 0 P0 / 0 P1 / 7 P2 / 11 P3 / 5 P4, with all web-side items remediated the same day."}, {"id": "docs_security_audit_p2_2_bucket_limits", "label": "P2-2: Live Bucket Limits Unverified", "file_type": "concept", "source_file": "docs/SECURITY-AUDIT-2026-09-14.md", "source_location": "Part 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client upload gates are browser-checkable labels; SECURITY.md \u00a78 and the audit doc contradicted on whether migration 21 or 29 limits were live \u2014 closed by a REST probe showing exactly the documented limits; web hardened anyway (download-disposition receipt links)."}, {"id": "docs_security_audit_p2_4_owner_scope", "label": "P2-4: Missing Owner-Scope on Mutations", "file_type": "concept", "source_file": "docs/SECURITY-AUDIT-2026-09-14.md", "source_location": "Part 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defense-in-depth inversion: services omitted the .eq('user_id', \u2026) predicates their docs called defense in depth, so a single future policy relaxation becomes cross-tenant; fixed by making userId params required everywhere (services/bin.ts was the correct template)."}, {"id": "docs_security_audit_p2_5_slot_squatting", "label": "P2-5: Recurring-Slot Squatting", "file_type": "concept", "source_file": "docs/SECURITY-AUDIT-2026-09-14.md", "source_location": "Part 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createExpense stamped recurring_rule_id/due_date from caller input with no ownership check \u2014 an attacker's row legitimately occupying a slot swallows the victim's idempotent upsert so their installment never books; RLS structurally cannot catch it; mitigated client-side, trigger question raised for the mobile repo."}, {"id": "docs_security_audit_p2_6_email_redirects", "label": "P2-6: Reset/Signup Redirects Off-Allowlist", "file_type": "concept", "source_file": "docs/SECURITY-AUDIT-2026-09-14.md", "source_location": "Part 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-/auth/callback redirect targets were silently rewritten to the spendflow:// Site URL (dead web recovery flows); fixed to bare /auth/callback with live probe verification and type=recovery landing on /profile?recovery=1."}, {"id": "docs_security_audit_p3_9_enumeration_safe", "label": "P3-9: Enumeration-Safe Auth Messaging", "file_type": "concept", "source_file": "docs/SECURITY-AUDIT-2026-09-14.md", "source_location": "Part 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sign-in maps wrong-email and wrong-password to one generic message; the reset flow's existence-answering posture was later changed by owner request (2026-09-15) with a DB-backed cooldown as the mitigation."}, {"id": "docs_security_audit_p2_1_note", "label": "P2-1: Missing CSP (Doc Claimed It Existed)", "file_type": "concept", "source_file": "docs/SECURITY-AUDIT-2026-09-14.md", "source_location": "Part 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "next.config.ts shipped every header SECURITY.md claimed except CSP \u2014 a doc-vs-code drift finding; remediated by shipping the documented non-nonce CSP with HSTS and pinned connect-src/img-src hosts."}], "edges": [{"source": "docs_security_audit_2026_09_14", "target": "docs_supabase", "relation": "cites", "confidence