{"nodes": [{"id": "docs_schema", "label": "SCHEMA.md \u2014 SpendFlow Database Schema", "file_type": "document", "source_file": "docs/SCHEMA.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived from reading all 34 committed SQL migrations in order (Supabase CLI not installed); this column-level contract is what web code must match until supabase gen types replaces/augments it."}, {"id": "docs_schema_users", "label": "public.users Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.users", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Profile row: preferred_currency, theme_preference, monthly_budget stored once with its own budget_currency (display conversion only), cycle_start_day 1 = calendar sentinel (29-31 valid), deletion_pending server-managed; no client DELETE."}, {"id": "docs_schema_categories", "label": "public.categories Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.categories", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "expenses/recurring_rules category_id FKs are ON DELETE RESTRICT \u2014 clients must reassign to a fallback category before deleting (mobile does)."}, {"id": "docs_schema_expenses", "label": "public.expenses Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.expenses", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Central ledger row: CHECK date 2000-01-01..today+1, FX snapshot columns, receipt path, soft delete, and UNIQUE (recurring_rule_id, recurring_due_date) dedup; client_sync_id kept as a future offline-queue hook with its unique index intentionally dropped."}, {"id": "docs_schema_recurring_rules", "label": "public.recurring_rules Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.recurring_rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "20260915 plan model: frequency incl. custom interval_days 1-365, mode pay_on_due/auto_charge, plan_start_date chain anchor, deleted_at Bin flag; WARNING bank_account_id exists in migration but was never applied live \u2014 never write it."}, {"id": "docs_schema_bank_accounts", "label": "public.bank_accounts Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.bank_accounts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "current_balance column is not authoritative \u2014 live balances are computed client-side from expenses + transfers + initial; one default per user via partial unique index."}, {"id": "docs_schema_transfers", "label": "public.transfers Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.transfers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FX rate locked on the row at creation: CHECK |converted_amount - amount x exchange_rate| <= 0.05 and from_account <> to_account; insert-only with no update path."}, {"id": "docs_schema_exchange_rates", "label": "public.exchange_rates Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.exchange_rates", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared reference data PK (currency, date); clients are read-only, writes are service-role/backfill; QAR/AED/SAR pegged (never stored/fetched), NPR = INR/1.6 derived."}, {"id": "docs_schema_market_gold_rates", "label": "public.market_gold_rates Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.market_gold_rates", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FENEGOSIDA daily fix rows (UNIQUE rate_date, country_code) written only by the pg_cron edge function; authenticated SELECT only; the Nepal bullion board must show ONLY verified rows."}, {"id": "docs_schema_user_settings_history", "label": "public.user_settings_history Table (Append-only)", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.user_settings_history", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Budget/cycle change trail: baseline row 1900-01-01, UNIQUE (user_id, effective_from), trigger-gated to baseline-or-current-month inserts, DELETE revoked \u2014 so past cycles compute with the budget active at the time."}, {"id": "docs_schema_category_budget_history", "label": "public.category_budget_history Table (Append-only)", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.category_budget_history", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_schema_notifications", "label": "public.notifications Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.notifications", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client-inserted on budget milestones (parity behavior on web); became the dedup source of truth for milestone alerts after the localStorage purge bug fix (2026-09-15)."}, {"id": "docs_schema_bin_receipt_orphans", "label": "public.bin_receipt_orphans Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.bin_receipt_orphans", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nightly purge (pg_cron spendflow-bin-purge 03:30 UTC) queues expired binned expenses' receipt paths here via SECURITY DEFINER functions (zero RLS policies); the owner's next Bin visit drains them client-side via claim_bin_receipt_orphans()."}, {"id": "docs_schema_security_otp_sends", "label": "public.security_otp_sends Table", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.security_otp_sends", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OTP cooldown ledger (composite PK user_id+purpose); RLS on with zero policies and all grants revoked \u2014 service-role only, invisible to every client."}, {"id": "docs_schema_recurring_slot_dedup", "label": "Recurring Slot-Key Dedup Index", "file_type": "rationale", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.expenses indexes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UNIQUE (recurring_rule_id, recurring_due_date) is non-partial: payment dates vary with late pays but slots don't, so a soft-deleted occurrence still holds its slot and 'Not paid \u2014 undo' must HARD-delete to free it; the old (recurring_rule_id, date) index is gone live \u2014 any upsert on it errors 42P10."}, {"id": "docs_schema_soft_delete", "label": "Soft Delete / 60-day Bin Pattern", "file_type": "rationale", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7known drift 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "deleted_at = now() makes expense and recurring-plan deletion a restorable Bin state (60 days); the web must never hard-delete either row outside services/bin.ts; queries filter deleted_at IS NULL exactly like mobile so stale clients can't resurrect rows."}, {"id": "docs_schema_fx_snapshot", "label": "Per-Row FX Snapshot Columns", "file_type": "concept", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.expenses", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "exchange_rate_to_usd + base_currency stamped at creation so historical views use each row's own-date rate, not today's \u2014 analytics/pivot logic depends on snapshots and the web must reproduce them or numbers diverge from mobile."}, {"id": "docs_schema_live_drift", "label": "Known Live Migration Drift", "file_type": "rationale", "source_file": "docs/SCHEMA.md", "source_location": "\u00a7Known live drift", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Migrations are not proof of live state: recurring_rules.bank_account_id never applied; transfers CHECKs had to be re-asserted in migration 34; migration 21's storage limits superseded by 29 \u2014 security-critical facts must be verified against the live DB."}], "edges": [{"source": "services_bin", "target": "docs_schema_bin_receipt_orphans", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.bin_receipt_orphans", "weight": 1}, {"source": "services_bin", "target": "docs_schema_soft_delete", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/SCHEMA.md", "source_location": "\u00a7Known live drift 6", "weight": 1}, {"source": "docs_supabase_receipts_bucket", "target": "docs_schema_expenses", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.expenses", "weight": 1}, {"source": "docs_supabase_avatars_bucket", "target": "docs_schema_users", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.users", "weight": 1}, {"source": "docs_schema", "target": "docs_schema_users", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/SCHEMA.md", "source_location": "\u00a7public.users", "weight": 1}, {"source": "docs_schema", "target": "docs_schema_categories", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1, "source_file": "docs/SCHEM