{"nodes": [{"id": "docs_00_existing_app_audit", "label": "00 \u2014 Existing App Audit (SpendFlow Mobile)", "file_type": "document", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designated source of truth for the web app: everything was read directly from the mobile repo and its 34 committed SQL migrations (audit date 2026-09-12)."}, {"id": "docs_00_existing_app_audit_auth_flow", "label": "Mobile Auth & Session Flow (End to End)", "file_type": "concept", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chunked SecureStore session adapter, OAuth deep-link trust gate (login-CSRF defense), soft-lock biometrics, ensureProfile bootstrap, OTP-gated email change, and a fail-closed account-deletion state machine requiring a fresh OTP-minted session."}, {"id": "docs_00_recurring_model", "label": "Recurring Payment Plan Model (Mobile)", "file_type": "concept", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": "\u00a73 Recurring", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schedule-locked chains (due slot = plan_start_date + N x cycle; late pays never shift the plan); billing mode pay_on_due shows a due card + explicit Mark Paid (never silent money) vs auto_charge posted by the generator; shared idempotent payment surface (markOccurrencePaid / skip / undo / payPlanFromForm with chain re-anchor)."}, {"id": "docs_00_bullion_calibrations", "label": "Bullion Market Calibrations (FENEGOSIDA / IBJA)", "file_type": "concept", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": "\u00a73 Bullion", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nepal FENEGOSIDA official fix (10:30 AM NPT; fine gold 1.20649, Tejabi 92.5588%, silver 1.22765) and India IBJA (AM/PM IST fixes; 1.0918 duty+GST calibration, 22K at 91.67%) \u2014 must stay byte-identical between clients."}, {"id": "docs_00_web_adaptations", "label": "Mobile-Only Behaviors to Adapt or Skip on Web", "file_type": "concept", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Biometric lock, screenshot blocking, haptics, push, on-device OCR, Apple sign-in, and swipe gestures are skipped or mapped to web equivalents (file input, blob downloads, toasts) for web v1."}, {"id": "services_expenses", "label": "services/expenses.ts", "file_type": "code", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ledger data layer (list/get/create/update/softDelete/setReceipt) joined to categories and bank_accounts; web mirrors the module-for-module structure and the audit's listExpenses query shape."}, {"id": "services_exchange", "label": "services/exchange.ts (getRate Tier Resolver)", "file_type": "code", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FX rate resolution in a fixed tier order (pegs \u2192 cache \u2192 exchange_rates table \u2192 public API \u2192 fallback) \u2014 byte-compatibility requirement #1 between clients."}, {"id": "services_recurring", "label": "services/recurring.ts", "file_type": "code", "source_file": "docs/00-EXISTING-APP-AUDIT.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared payment surface (markOccurrencePaid, skipCurrentOccurrence, undoLatestOccurrencePayment, payPlanFromForm) idempotent against the other client via the slot-key dedup index."}, {"id": "services_auth", "label": "s