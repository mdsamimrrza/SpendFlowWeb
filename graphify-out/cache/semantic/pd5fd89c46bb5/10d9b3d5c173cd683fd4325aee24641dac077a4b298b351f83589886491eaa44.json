{"nodes": [{"id": "agents", "label": "AGENTS.md \u2014 SpendFlow Web Agent Rules", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_priority_of_information", "label": "Priority of Information Order", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a7Priority of information", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When sources disagree, explicit user instruction beats the mobile audit, which beats ARCHITECTURE.md, which beats other docs; general assumptions are a last resort and a smell. This ordering exists because guessing at undocumented mobile behavior produces a second product."}, {"id": "agents_mobile_first", "label": "Mobile-First Every Screen Rule", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a7Brand & design", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pages are designed at 390 px first then enhanced upward (sm/md/lg), never desktop-first with shrink-to-fit; phones get the full feature set (progressive enhancement, not a stripped view), verified by shot-preview scripts at 4 widths x 2 themes."}, {"id": "agents_lucide_icons", "label": "Lucide-Only Icon Rule", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a7Brand & design", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The shared DB stores category/account icons as emoji (mobile writes them); stored glyphs are data, never rendered as text \u2014 every UI icon is a lucide-react component resolved through components/ui/Glyph.tsx."}, {"id": "agents_i18n_trilingual", "label": "Trilingual i18n Coverage Rule", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "\u00a7Brand & design", "source_url": null, "captured_at": null, "author": 