# SpendFlow Web — environment variables
# Copy to .env.local (or .env — both gitignored, Next loads either) and fill
# in. Never commit real keys.

# Supabase (same project as the mobile app — anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: FX rates are fetched from the hardcoded frankfurter feed in
# services/exchange.ts (CSP connect-src in next.config.ts allows exactly this
# host). The mobile app has EXPO_PUBLIC_EXCHANGE_RATE_API_URL overrides; the
# web app deliberately does NOT — do not add NEXT_PUBLIC_EXCHANGE_* vars here,
# they would be dead config (audit 2026-09-15: previously-declared vars here
# were read by no source file and pointed at a host the CSP would block).

# Custom SMTP mailbox for outbound auth email (signup/reset/security-OTP).
# NOT read by the running web app — consumed only by
# scripts/configure-smtp.mjs, which pushes it to the Supabase project's Auth
# config (Dashboard → Authentication → SMTP settings is the manual equivalent).
# See docs/SUPABASE.md §7.2.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="SpendFlow <no-reply@example.com>"

# NEVER set these in the web app (service-role / server-only secrets stay in the
# mobile repo's server-only contexts and edge functions):
# SUPABASE_SERVICE_ROLE_KEY=
# EXCHANGE_RATE_API_KEY=
# EXCHANGE_RATE_HOST_ACCESS_KEY=
