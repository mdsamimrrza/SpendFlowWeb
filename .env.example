# SpendFlow Web — environment variables
# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# Supabase (same project as the mobile app — anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://stisbfahlhquaqhrifjh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: override public FX rate endpoints (defaults match the mobile app)
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest
NEXT_PUBLIC_EXCHANGE_RATE_FALLBACK_API_URL=https://api.exchangerate-api.com/v4/latest

# Custom SMTP mailbox for outbound auth email (signup/reset/security-OTP).
# NOT read by the running web app — consumed only by
# scripts/configure-smtp.mjs, which pushes it to the Supabase project's Auth
# config (Dashboard → Authentication → SMTP settings is the manual equivalent).
# See docs/SUPABASE.md §7.2.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="SpendFlow <no-reply@example.com>"

# NEVER set these in the web app (service-role / server-only secrets stay in the
# mobile repo's server-only contexts and edge functions):
# SUPABASE_SERVICE_ROLE_KEY=
# EXCHANGE_RATE_API_KEY=
# EXCHANGE_RATE_HOST_ACCESS_KEY=
